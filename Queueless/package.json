{
  "name": "queueless",
  "version": "1.0.0",
  "description": "QueueLess Enterprise Multi-Tenant Queue & Appointment Platform",
  "main": "index.js",
  "scripts": {
    "build:backend": "npm run build -w apps/backend",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:backend && npm run build:web",
    "test:backend": "npm run test -w apps/backend",
    "test:mobile": "npm run test -w apps/mobile",
    "lint:mobile": "npm run lint -w apps/mobile",
    "test": "npm run test:backend",
    "db:push": "npm run db:push -w apps/backend",
    "seed": "npm run seed -w apps/backend",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "npm start -w apps/web",
    "dev:mobile": "npm start -w apps/mobile",
    "dev:mobile:tunnel": "npm start -w apps/mobile -- --tunnel",
    "dev:mobile:clear": "npm start -w apps/mobile -- -c"
  },
  "keywords": [
    "queue-management",
    "appointments",
    "multi-tenant",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
