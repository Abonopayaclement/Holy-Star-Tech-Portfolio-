{
  "expo": {
    "name": "QueueLess",
    "slug": "queueless",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "queueless",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.queueless.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "QueueLess uses your camera to scan QR codes for branch services and queue check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.queueless.customer",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "QueueLess requires camera access to scan QueueLess QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
